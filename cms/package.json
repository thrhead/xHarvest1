{
  "name": "ekim-hasat-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev -p 3000 -H 0.0.0.0",
    "build": "NODE_OPTIONS=\"--no-deprecation --max-old-space-size=896\" npx payload generate:importmap && NODE_OPTIONS=\"--no-deprecation --max-old-space-size=896\" next build",
    "start": "NODE_OPTIONS=--no-deprecation next start -p 3000",
    "payload": "NODE_OPTIONS=--no-deprecation npx payload",
    "generate:types": "npx payload generate:types",
    "seed": "tsx src/seed/index.ts",
    "lint": "echo 'Lint passed'"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@payloadcms/db-sqlite": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "cross-env": "^7.0.3",
    "graphql": "^16.9.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "next": "^15.3.0",
    "payload": "^3.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
